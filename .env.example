# ============================================================
# One-UI-Trader — Environment Variables Template
# ============================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit `.env` to Git!
# ============================================================

# Finnhub API Key (get one free at https://finnhub.io)
FINNHUB_KEY=your_finnhub_api_key_here

# Groq API Key (get one at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (get one at https://aistudio.google.com)
# Used in the app's Settings UI — also set via the frontend settings panel.
GEMINI_API_KEY=your_gemini_api_key_here
